## Sample Code

### Association Rule Mining
```r
library(arules)
library(arulesViz)

# Binarise benefit columns
df_arm <- as.data.frame(lapply(df_clean[, 4:24], function(x) {
  as.factor(ifelse(x > 0, "Yes", "No"))
}))

trans <- as(df_arm, "transactions")

# Generate rules
rules <- apriori(trans, parameter = list(supp = 0.02, conf = 0.8, minlen = 2))
inspect(head(sort(rules, by = "lift"), 10))

# Visualise
plot(rules, method = "graph", engine = "htmlwidget")
```

### Logistic Regression
```r
# Create binary target
median_js <- median(house_numeric$JobSeeker.Payment, na.rm = TRUE)
house_full$high_jobseeker <- as.factor(ifelse(
  house_full$JobSeeker.Payment > median_js, 1, 0
))

# Train/test split
set.seed(123)
pd <- sample(2, nrow(house_full), replace = TRUE, prob = c(0.7, 0.3))
train <- house_full[pd == 1, ]
test  <- house_full[pd == 2, ]

# Fit model
model <- glm(high_jobseeker ~ ., data = train, family = "binomial")
summary(model)

# Evaluate
test_pred <- ifelse(predict(model, newdata = test, type = "response") > 0.5, 1, 0)
test_tab  <- table(predicted = test_pred, actual = test$high_jobseeker)
cat("Test Accuracy:", sum(diag(test_tab)) / sum(test_tab))
```

